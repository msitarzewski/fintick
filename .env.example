# FinTick configuration — copy to .env (which is gitignored) and edit.

# ── Inference (event aggregation) ────────────────────────────────────────────
# A plain OpenAI-compatible endpoint. Defaults to a free local ollama server;
# no Hermes, OAuth, or HOME dependency. Point these at any OpenAI-compatible
# provider for cloud.
FINTICK_LLM_BASE_URL=http://localhost:11434/v1
FINTICK_LLM_API_KEY=ollama
FINTICK_LLM_MODEL=qwen3.8:27b

# Cloud option (e.g. GPT-5.6 Luna — roughly a couple dollars a month at this
# stream's volume). Uncomment and set your key:
# FINTICK_LLM_BASE_URL=https://api.openai.com/v1
# FINTICK_LLM_API_KEY=sk-...
# FINTICK_LLM_MODEL=gpt-5.6-luna

# ── News validation (optional) ───────────────────────────────────────────────
# Partner token for enriched validation sources. Leave unset to fall back to
# free public news RSS.
# FINTICK_COMMON_VISION_TOKEN=
